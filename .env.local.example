# Copy to .env.local and paste your key
ANTHROPIC_API_KEY=sk-ant-...

# Hermes Agent (only used by HERMES-07)
HERMES_BASE_URL=http://localhost:8642/v1
HERMES_API_KEY=local-dev

# Obsidian vault auto-save (path to vault folder, the one containing .obsidian/)
OBSIDIAN_VAULT=/Users/cypmacmini/Library/Mobile Documents/iCloud~md~obsidian/Documents/cyp vault

# Gemini (GEMINI-08 vision agent) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model string when Google renames it
GEMINI_MODEL=gemini-3.1-pro-preview
